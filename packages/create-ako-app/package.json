{
  "name": "create-ako-app",
  "version": "0.2.1",
  "type": "module",
  "description": "ako-starter şablonundan web / mobil / ikisini içeren yeni bir proje üretir.",
  "keywords": [
    "create",
    "template",
    "starter",
    "monorepo",
    "react-router",
    "expo",
    "dotnet",
    "mari-ui"
  ],
  "license": "MIT",
  "author": "Aykut Yılmaz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aykutyilmaz37/ako-starter.git",
    "directory": "packages/create-ako-app"
  },
  "homepage": "https://github.com/aykutyilmaz37/ako-starter#readme",
  "bugs": "https://github.com/aykutyilmaz37/ako-starter/issues",
  "engines": {
    "node": ">=24.19"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "create-ako-app": "./bin/create-ako-app.mjs"
  },
  "files": [
    "bin",
    "src/*.mjs",
    "!src/*.test.mjs",
    "variants",
    "template"
  ],
  "scripts": {
    "test": "vitest run",
    "build:template": "node scripts/build-template.mjs",
    "verify": "node scripts/verify-combos.mjs",
    "variants": "node scripts/refresh-variants.mjs",
    "changeset": "cd ../.. && changeset",
    "version-packages": "cd ../.. && changeset version",
    "release": "node scripts/stage-release.mjs",
    "prepack": "node scripts/build-template.mjs",
    "postpack": "node scripts/build-template.mjs --clean"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@types/node": "^26.6.5",
    "vitest": "^5.0.5"
  }
}
