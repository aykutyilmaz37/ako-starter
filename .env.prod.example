# compose.prod.yaml için ayarlar: cp .env.prod.example .env.prod (bu dosya git'e girmez).
# Gizli değerler: openssl rand -base64 48

# Veritabanı
POSTGRES_PASSWORD=
# POSTGRES_DB=ako
# POSTGRES_USER=ako

# ako:begin auth
# İlk Admin hesabı ("migrate" adımında, yoksa oluşturulur). Açıldıktan sonra şifreyi değiştirip bu değerleri silebilirsiniz.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# ako:end auth

# ako:begin site
SITE_URL=https://example.com
SITE_SESSION_SECRET=
# SITE_PORT=3000  (host'ta 127.0.0.1:<port>; reverse proxy buraya yönlendirir)
# ako:end site
# ako:begin backoffice
BACKOFFICE_URL=https://admin.example.com
BACKOFFICE_SESSION_SECRET=
# BACKOFFICE_PORT=3001
# ako:end backoffice

# API dışarı açıksa (mobil uygulama, sosyal giriş) tarayıcının ulaştığı adres
API_PUBLIC_URL=

# E-posta (kayıt doğrulama, şifre sıfırlama)
EMAIL_FROM=no-reply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Gözlemlenebilirlik (isteğe bağlı): OTLP alıcısı, ör. http://otel-collector:4317
OTEL_EXPORTER_OTLP_ENDPOINT=

# İmaj adı öneki (ako-api, ako-site…)
# IMAGE_PREFIX=ako
