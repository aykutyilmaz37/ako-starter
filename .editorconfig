root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csproj,sln,slnx}]
indent_size = 4

# Bir özelliğin tüm dosyaları tek namespace'te durur (Ako.Api.Features.<Özellik>);
# Actions/, Contracts/, Data/ ve Services/ klasörleri yalnızca düzen içindir, using kalabalığı olmasın diye.
[apps/api/src/Ako.Api/Features/**.cs]
dotnet_diagnostic.IDE0130.severity = none
